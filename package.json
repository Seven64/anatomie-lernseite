{
  "name": "anatomie-lernseite",
  "version": "1.1.0",
  "description": "Interaktive Anatomie-Lernseite mit 3D-Modellen",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "npm run dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run data:export && node scripts/sync-structures.js --check",
    "desktop:dir": "npm run build && electron-builder --dir",
    "desktop:win": "npm run build && electron-builder --win nsis",
    "data:export": "node scripts/export-data.js",
    "icon": "sh scripts/make-icon.sh",
    "test:blender": "blender --background --python scripts/blender/export_gltf.py",
    "data:sync": "node scripts/sync-structures.js",
    "test:e2e": "playwright test --project=web --project=web-mobile",
    "test:desktop": "E2E_NO_SERVER=1 playwright test --project=desktop"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "@types/three": "^0.165.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "idb": "^8.0.0",
    "three": "^0.165.0",
    "three-mesh-bvh": "^0.8.3",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "de.anatomie-lernseite.desktop",
    "productName": "Anatomie Lernseite",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Anatomie-Lernseite-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "installer/license_de.html",
      "language": "1031",
      "installerLanguages": [
        "de_DE"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Seven64",
        "repo": "anatomie-lernseite",
        "releaseType": "release"
      }
    ]
  }
}
