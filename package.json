{
  "name": "anatomie-lernseite",
  "version": "1.0.0",
  "description": "Interaktive Anatomie-Lernseite mit 3D-Modellen",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "npm run dev",
    "desktop:dir": "npm run build && electron-builder --dir",
    "desktop:win": "npm run build && electron-builder --win nsis",
    "data:export": "node scripts/export-data.js",
    "test:blender": "blender --background --python scripts/export_gltf.py"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "idb": "^8.0.0",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/three": "^0.165.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  },
  "build": {
    "appId": "de.anatomie-lernseite.desktop",
    "productName": "Anatomie Lernseite",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "installer/license_de.html",
      "language": "1031",
      "installerLanguages": [
        "de_DE"
      ]
    }
  }
}
