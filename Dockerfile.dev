# Development Dockerfile for Anatomie Lernseite
# Runs Vite dev server with hot reload

FROM node:20-alpine

WORKDIR /app

# Install git for any git dependencies
RUN apk add --no-cache git

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Expose Vite dev server port
EXPOSE 5173

# Start dev server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]